# modbus_config.options — nanopb bounds (must keep every message under the
# envelope payload caps: request 512 B, response 1536 B).

ce.embedded.modbus.v1.ModbusConfig.devices            max_count:16
ce.embedded.modbus.v1.ModbusConfig.points             max_count:64
ce.embedded.modbus.v1.ModbusConfigDelta.upsert_devices    max_count:8
ce.embedded.modbus.v1.ModbusConfigDelta.upsert_points     max_count:16
ce.embedded.modbus.v1.ModbusConfigDelta.remove_device_ids max_count:8
ce.embedded.modbus.v1.ModbusConfigDelta.remove_point_ids  max_count:16
ce.embedded.modbus.v1.ModbusPointDef.name             max_size:24
ce.embedded.modbus.v1.ModbusConfig.config_hash        max_size:17

# Sync-prune (0.4.3): keep lists bound to the full pool (snapshot caps), since
# they carry the host's COMPLETE desired id set in one final chunk.
ce.embedded.modbus.v1.ModbusConfigDelta.keep_device_ids max_count:16
ce.embedded.modbus.v1.ModbusConfigDelta.keep_point_ids  max_count:64
