# bacnet_points.options — nanopb bounds. A full PointValues batch (32 points)
# must stay under the 1536 B response-payload cap: 32 * ~35 B ≈ 1120 B. OK.
#
# Same bounds as modbus_points.options: the messages are field-identical, so the
# size argument carries over unchanged.

ce.embedded.bacnet.v1.PointValues.values          max_count:32
ce.embedded.bacnet.v1.PointReadRequest.point_ids  max_count:32
